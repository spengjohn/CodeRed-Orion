#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

if [[ -d /usr/local/lib/pkgconfig ]]; then
  export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
fi
if [[ -d /usr/local/lib ]]; then
  export LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

if [[ -f third_party/coral/env.sh ]]; then
  # shellcheck disable=SC1091
  source third_party/coral/env.sh
fi

if [[ ! -f .env ]]; then
  echo "Missing .env — copy env_template.txt to .env and fill in values." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1091
source .env
set +a

if ! pkg-config --exists libpq; then
  echo "libpq not found. Install libpq-dev (apt) or set PKG_CONFIG_PATH." >&2
  exit 1
fi

if [[ -z "${TIGERDATA_URL:-}" ]]; then
  echo "TIGERDATA_URL is empty in .env" >&2
  exit 1
fi

if [[ "${ENABLE_CORAL:-0}" == "1" ]]; then
  # Defaults: reuse C_Hardware_Testing's finished TFLite (do NOT re-fetch).
  : "${TENSORFLOW_SOURCE_DIR:=$HOME/Projects/C_Hardware_Testing/third_party/tensorflow}"
  : "${TFLITE_BINARY_DIR:=$HOME/Projects/C_Hardware_Testing/third_party/tflite_build}"
  : "${EDGETPU_INCLUDE:=$HOME/Projects/C_Hardware_Testing/third_party/coral/include}"

  mkdir -p third_party/coral
  if [[ ! -e third_party/coral/include ]]; then
    ln -sfn "${EDGETPU_INCLUDE}" third_party/coral/include
  fi

  if [[ ! -f third_party/coral/include/edgetpu.h ]]; then
    echo "ENABLE_CORAL=1 but edgetpu.h missing at ${EDGETPU_INCLUDE}" >&2
    exit 1
  fi
  if [[ ! -d "${TENSORFLOW_SOURCE_DIR}/tensorflow/lite" ]]; then
    echo "ENABLE_CORAL=1 but TENSORFLOW_SOURCE_DIR incomplete: ${TENSORFLOW_SOURCE_DIR}" >&2
    exit 1
  fi
  if [[ ! -f "${TFLITE_BINARY_DIR}/libtensorflow-lite.a" ]]; then
    echo "Prebuilt TFLite not found: ${TFLITE_BINARY_DIR}/libtensorflow-lite.a" >&2
    echo "Build it once in C_Hardware_Testing (setup_coral_cpp.sh), then retry." >&2
    exit 1
  fi

  echo "Building Orion edge with PREBUILT TFLite (fast path)"
  echo "  TENSORFLOW_SOURCE_DIR=${TENSORFLOW_SOURCE_DIR}"
  echo "  TFLITE_BINARY_DIR=${TFLITE_BINARY_DIR}"
  cmake -S . -B build-coral \
    -DENABLE_CORAL=ON \
    -DCORAL_USE_PREBUILT_TFLITE=ON \
    -DTENSORFLOW_SOURCE_DIR="${TENSORFLOW_SOURCE_DIR}" \
    -DTFLITE_BINARY_DIR="${TFLITE_BINARY_DIR}"
  cmake --build build-coral -j"$(nproc 2>/dev/null || echo 2)" --target edge
  exec ./build-coral/edge "$@"
fi

LIBCAMERA_FLAGS=()
if pkg-config --exists libcamera 2>/dev/null; then
  LIBCAMERA_FLAGS+=(-DHAS_LIBCAMERA)
  # shellcheck disable=SC2207
  LIBCAMERA_FLAGS+=($(pkg-config --cflags --libs libcamera))
else
  echo "warning: libcamera not found; OV5647 will use demo mode" >&2
fi

echo "Building edge (Coral demo mode — set ENABLE_CORAL=1 after setup_coral_cpp.sh for live TPU)"

g++ -std=c++17 \
  -Isrc -Isrc/hardware -Isrc/hardware/mlx90640 \
  src/main.cpp \
  src/config/Config.cpp \
  src/hardware/ADS1115Driver.cpp \
  src/hardware/CoralDriver.cpp \
  src/hardware/MaestroDriver.cpp \
  src/hardware/MLX90640Driver.cpp \
  src/hardware/OV5647.cpp \
  src/hardware/TfLunaDriver.cpp \
  src/hardware/mlx90640/MLX90640_API.cpp \
  src/hardware/mlx90640/MLX90640_LINUX_I2C_Driver.cpp \
  src/net/TimeseriesClient.cpp \
  src/net/UplinkClient.cpp \
  src/pipeline/BabyTrackPipeline.cpp \
  src/pipeline/IrStreamPipeline.cpp \
  src/util/Base64.cpp \
  src/vision/BreathMonitor.cpp \
  src/vision/CameraFusion.cpp \
  src/vision/ThermalRoiSampler.cpp \
  src/vitals/PressurePlate.cpp \
  src/vitals/VitalsHub.cpp \
  -o edge \
  $(pkg-config --cflags --libs libpq) \
  "${LIBCAMERA_FLAGS[@]}" \
  -lpthread \
  -lm

exec ./edge "$@"
