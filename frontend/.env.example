# Copy to .env and adjust. .env is gitignored.
# Only VITE_-prefixed variables are baked into the built site; the rest are
# read by vite.config.js and the contract tests only.

# Flask backend: `flask --app app run` serves on 5000; `python run.py` reads PORT
# from backend/.env. Must match the port Flask actually uses.
BACKEND_HOST=localhost
BACKEND_PORT=5000
# Or a full URL, which wins over host and port. The deployed backend is only
# reachable through nginx over HTTPS, so use this to develop against it.
# BACKEND_URL=https://whisker.health

# Vite dev server and preview. The dev proxy makes the port irrelevant to the
# backend; 1234 matches the backend's default FRONTEND_URL if that ever matters.
FRONTEND_HOST=localhost
FRONTEND_PORT=5173

# REST base URL used by the browser (src/api/client.js). Defaults to /api,
# which the Vite proxy or nginx forwards to Flask; leave unset unless the API
# lives on another origin. Never put secrets in VITE_ variables.
# VITE_API_BASE_URL=/api

# Auth0 single-page app (see README "Auth0 setup"). Without a domain and client
# ID the app runs in demo mode: a local sign-in flag and no token of its own.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=
# Must equal AUTH0_AUDIENCE in backend/.env, or the backend rejects the token.
# VITE_AUTH0_AUDIENCE=

# An Auth0 access token for development. The dev server's proxy adds it to
# /api and /socket.io requests (unless the browser sent its own), so demo mode
# gets real data; it never reaches the browser or the build. The contract tests
# use it too. Tokens expire, so paste a fresh one when the dev server warns.
# Never give it a VITE_ prefix.
# DEV_AUTH_TOKEN=

# The dev server prints one line per proxied backend call (time, path,
# status, duration, token source). Set to 0 to silence it.
# DEV_PROXY_LOG=0

# Contract tests only: overrides DEV_AUTH_TOKEN.
# AUTH_TOKEN=
