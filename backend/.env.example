# Copy to backend/.env and fill in. Never commit .env.

# Tiger Data (Postgres connection string from the Tiger Data console, and the table name)
TIGER_DATABASE_URL=
TIGER_TABLE=

# Alerts table in Tiger Data (default: alerts)
TIGER_ALERT_TABLE=

# Twilio voice-call alerts (leave empty to run in mock mode: calls are only logged)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio number the alert calls come from, in +1XXXXXXXXXX format
TWILIO_PHONE_NUMBER=

# Auth0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Dev only: an Auth0 access token for scripts/watch_vitals.py (expires, usually ~24 h)
AUTH0_TEST_TOKEN=
